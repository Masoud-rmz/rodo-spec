{
  "name": "@rodo/cli",
  "version": "2.1.0",
  "description": "RODO method CLI — install the kit, manage cards, sync with the board",
  "type": "module",
  "bin": {
    "rodo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://github.com/alishafiee1/rodo-spec",
  "repository": {
    "type": "git",
    "url": "https://github.com/alishafiee1/rodo-spec.git"
  },
  "keywords": [
    "rodo",
    "project-management",
    "ai",
    "cli",
    "method",
    "cards",
    "workflow"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
